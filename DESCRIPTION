Package: nguliaforcast
Title: Ngulia Daily Count and Mist Forecast
Version: 1.0.0
Authors@R: person("Ngulia Ringing Project", role = c("aut", "cre"), email = "info@example.org")
Description: Trains the Ngulia daily count model, applies the frozen mist CNN,
    retrieves ECMWF forecasts from Open-Meteo, and builds the static forecast
    data used by the project website.
License: CC BY 4.0
Encoding: UTF-8
Imports:
    DT,
    cli,
    dplyr,
    ggplot2,
    jsonlite,
    here,
    htmltools,
    lubridate,
    mgcv,
    plotly,
    readr,
    tibble,
    tidyr
